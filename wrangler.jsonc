{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parley",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Nitro's Durable Object; Parley uses its storage as the usage meter (messages per minute, daily neurons).
  "durable_objects": {
    "bindings": [{ "name": "$DurableObject", "class_name": "$DurableObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["$DurableObject"] }],
  "ratelimits": [
    {
      // About 5 messages per minute, checked per IP and per session.
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // Turnstile verifications per IP.
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    // Public values. The secrets TURNSTILE_SECRET and SESSION_SECRET are set with `wrangler secret put`.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFJmHYMonB277qOO",
    "TURNSTILE_HOSTNAMES": "parley.emircan-erdemci.workers.dev"
  }
}
